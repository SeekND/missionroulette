    "purpose": "Rentable-ship roster for Mission Roulette story mode (rentals are the only ships allowed). Full current data from the SC wiki.",
    "updated": "2026-08-02",
    "gamePatch": "Data is Alpha 4.8.2 (wiki 'last updated Jul 10 2026'). Live game is 4.9 (4.10 in ~2 weeks) — re-pull next patch.",
    "source": "starcitizen.tools Ship_renting — pulled from its ag-grid data API. 122 location listings -> 49 unique vehicles.",
    "mechanics": {
      "durations": "1, 3, or 7 days",
      "discount": "1d 0%, 3d 10%, 7d 25% (as of v4.8.0)",
      "priceDerivation": "Only 1-day price stored. 3-day = round(p1 * 3 * 0.90); 7-day = round(p1 * 7 * 0.75).",
      "timer": "Real-world time — counts down even while logged off. When it expires the ship is gone.",
      "rules": "Includes default loadout + full insurance. Cargo/gear OK, but no weapon/component modification (mobiGlas customization disabled).",
      "locations": ["Area 18", "Lorville", "New Babbage", "Orison", "Levski", "Cargo Deck", "Refinery Deck"]
    },
    "storyNotes": {
      "firstShipOnly": "Only the FIRST ship's price matters (what you earn to start). After that, chapter completion gates progression, not price.",
      "cheapestFlyableShip": "Aurora Mk I ES — 6,350 aUEC/day at Area 18 or Orison.",
      "mainShipMustBeQuantum": "A rented MAIN ship must be quantum-capable. Ground/snub vehicles need a carrier and are never the main ship.",
      "deferred": "RACING has no missions in-game (removed) — the racing ships (M50, Mustang Gamma, Razor) are folded into light fighters; a racing mode is deferred to v2/v3. MEDICAL is not a profession (no missions/requirements) — medical ships are storyUse:utility (self-repair only), deferred as an aspiration.",
      "situationalAndExcluded": "STV, Cyclone, Ursa, Ursa Medivac, ROC, Dragonfly (storyUse:situational) are ground/snub vehicles used ONLY if a mission forces ground work. MPUV Tractor (storyUse:excluded) is not used at all."
    },
    "conventions": {
      "byLocation": "location -> 1-day price in aUEC (availability + price; a ship only appears where it's actually rentable)",
      "quantum": "true = valid MAIN ship (travels the system). false = ground/snub; needs a carrier.",
      "needsCarrier": "true = must be hauled inside a carrier ship",
      "carriers": "example rentable ships that can transport this ground vehicle (not exhaustive)",
      "storyUse": "main = progression/aspiration ship · situational = ground vehicle only for a forced ground objective · utility = self-support (medical), not an aspiration · excluded = not used",
      "tierHint": "loose capability rung 1-4; NOT a hard gate (chapters gate progression)",
      "category": "primary role bucket for aspiration matching"
    }
  },

